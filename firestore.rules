rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Identity Validation Interceptors
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Dynamic User State & Theme Profiles (Ambition 11)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Private Wardrobe Closets (Ambition 4: hhhhgvault)
    match /wardrobe/{itemId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // 3. Creative AI Studio Lookbooks (Ambition 3: AI Creations)
    match /generatedLooks/{lookId} {
      allow read: if true; // Publicly readable for the inspiration feed
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Collaborative Collections & Style DNA (Ambition 2 & 10)
    match /styles/{styleId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    match /styleProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 5. Global Commerce Inventories (Ambition 5: Boutique Marketplace)
    match /products/{productId} {
      allow read: if true; // Anyone can browse items
      allow write: if isSignedIn(); // Logged-in vendors can upload product SKUs
    }

    // 6. In-Memory Pipeline Registries
    match /analytics/{docId} {
      allow read, write: if true;
    }

    // 7. Global Anti-Tamper Safeguard
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if false; // Blocks administrative tampering
    }
  }
}


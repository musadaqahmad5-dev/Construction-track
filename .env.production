# =========================================================================
# PRODUCTION INFRASTRUCTURE CONFIGURATION
# =========================================================================

# Runtime Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Gemini AI Engine Server-Side Secret Key
GEMINI_API_KEY=YOUR_SECURE_SERVER_KEY

# Ingress & CORS Whitelist Directives
CORS_ORIGIN=https://aifashionmarket.com

# Client Application URL
APP_URL=https://aifashionmarket.com
VITE_API_BASE_URL=https://aifashionmarket.com/api

# Telemetry & Compression
LOG_LEVEL=info
ENABLE_GZIP_COMPRESSION=true
ENABLE_SSL_STRICT_TRANSPORT=true
